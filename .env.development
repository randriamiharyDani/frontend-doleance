# =====================================================
# Frontend - configuration de DÉVELOPPEMENT LOCAL uniquement
# Ce fichier est chargé en priorité par Vite en mode `dev`
# (ordre : .env.development > .env). Il n'affecte pas les
# builds de production (qui utilisent .env / .env.production).
# =====================================================
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

VITE_APP_HOST=localhost

# Vite 5.4+ : hôtes autorisés pour `npm run dev` (protection DNS-rebinding).
# Sans webapp.cua.mg ici => "Blocked request. This host is not allowed".
VITE_ALLOWED_HOSTS=webapp.cua.mg,localhost,127.0.0.1
