# =====================================================
# Frontend - configuration de production
# =====================================================
# Le build est servi A LA RACINE du domaine par Apache
# (cf. frontend/public/.htaccess, copie dans dist/).
# Apache reverse-proxy le backend Node sur le port 5000 :
#   /api        -> http://127.0.0.1:5000/api
#   /uploads    -> http://127.0.0.1:5000/uploads
#   /socket.io/ -> ws://127.0.0.1:5000/socket.io
# => les appels API et le WebSocket passent par le meme
#    origine : aucune erreur CORS, aucun port a ouvrir.

# URL de l'API : chemin relatif, resolu par le reverse-proxy Apache.
VITE_API_URL=/api

# Socket.IO : laisse VIDE => le code (socket.js / guestSocket.js) utilise
# window.location.origin et se connecte donc au meme hote que la page.
# NE PAS supprimer la ligne et la laisser vide "par defaut" : Vite charge
# `.env` AVANT `.env.production`, donc une variable absente d'ici
# herite de sa valeur dans `.env` (IP de dev) et se retrouve
# codee en dur dans le build de production.
VITE_SOCKET_URL=

# Si le WebSocket doit etre accessible directement sur le port 5000,
# decommenter la ligne ci-dessous ET ajouter l'origine du site dans
# CORS_ORIGINS (backend/.env).
# VITE_SOCKET_URL=http://192.168.99.4:5000

VITE_APP_NAME="Gestion des Doleances CUA"
VITE_APP_VERSION="1.0.0"